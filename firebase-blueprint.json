{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Streetwear catalog item with inventory and sizing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "enum": ["all", "hoodies", "tees", "pants", "jackets", "accessories"] },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 64 },
        "gsm": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "tags": { "type": "array" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "category", "price", "stock", "sku"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with line items and shipping details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerName", "customerEmail", "address", "city", "postalCode", "items", "total", "status"]
    },
    "DeliverySettings": {
      "title": "DeliverySettings",
      "description": "Store shipping and delivery fee thresholds",
      "type": "object",
      "properties": {
        "deliveryFee": { "type": "number" },
        "isFreeDelivery": { "type": "boolean" },
        "enableFreeDeliveryThreshold": { "type": "boolean" },
        "freeDeliveryThreshold": { "type": "number" }
      },
      "required": ["deliveryFee", "isFreeDelivery"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog products viewable by customers and manageable by admin"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders submitted during checkout and reviewed in admin order hub"
    },
    "/deliverySettings/{settingsId}": {
      "schema": "DeliverySettings",
      "description": "Global store delivery calculation configuration"
    }
  }
}
