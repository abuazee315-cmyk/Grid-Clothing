{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Streetwear catalog SKU item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "description": { "type": "string" },
        "fabricDetails": { "type": "string" },
        "fitDetails": { "type": "string" },
        "badge": { "type": "string" },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sku", "name", "category", "price", "stock", "images"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer e-commerce order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "estimatedDeliveryDate": { "type": "string" },
        "dispatchDate": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "customerEmail", "items", "total", "status", "createdAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and delivery thresholds",
      "type": "object",
      "properties": {
        "isFreeDelivery": { "type": "boolean" },
        "deliveryFee": { "type": "number" },
        "enableFreeDeliveryThreshold": { "type": "boolean" },
        "freeDeliveryThreshold": { "type": "number" },
        "expressCourierName": { "type": "string" },
        "storeUrl": { "type": "string" },
        "supportEmail": { "type": "string" }
      },
      "required": ["isFreeDelivery", "deliveryFee"]
    },
    "CustomerAccount": {
      "title": "CustomerAccount",
      "description": "Customer registered profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "phone": { "type": "string" },
        "savedAddress": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global storefront products and inventory records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders and fulfillment details"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store operational settings and delivery fees"
    },
    "/customers/{customerId}": {
      "schema": "CustomerAccount",
      "description": "Client profile records and saved shipping addresses"
    }
  }
}
