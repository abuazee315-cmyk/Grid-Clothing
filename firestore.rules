rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 150 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.sku is string && data.sku.size() <= 64;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 120 &&
             data.customerEmail is string && data.customerEmail.size() <= 150 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isValidId(orderId);
    }

    // Delivery settings
    match /deliverySettings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }
  }
}
