rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }

    // Store settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Customer accounts
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }
  }
}
